# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Security (CHANGE THIS) ----
SESSION_SECRET=change-this-to-a-long-random-string

# ---- Seeded admin account (used only on first startup) ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-use-12-plus-characters

# ---- AI (optional - app works fully without it) ----
# Options: gemini | openai | ollama | none
AI_PROVIDER=none
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ---- Threat Intelligence (optional) ----
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# ---- Demo ----
# true = fill an EMPTY database with sample events on startup (good for a public demo)
DEMO_MODE=false

# ---- Security ----
# true = browser only REPORTS Content-Security-Policy violations instead of blocking
CSP_REPORT_ONLY=false
