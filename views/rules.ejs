<div class="page-heading-row mb-4">
  <div><div class="eyebrow">ANALYZE / DETECTION LOGIC</div><h1 class="mb-1">Detection rules</h1><div class="text-secondary small"><%= rules.length %> rule(s) match the current filters</div></div>
</div>

<% if (updated === 'enabled') { %><div class="alert alert-success" role="status">Rule enabled. New events will be evaluated against it.</div><% } %>
<% if (updated === 'disabled') { %><div class="alert alert-secondary" role="status">Rule disabled. Existing alerts and logs are unchanged.</div><% } %>
<% if (updated === 'not-found') { %><div class="alert alert-warning" role="alert">That rule no longer exists.</div><% } %>
<% if (updated === 'error') { %><div class="alert alert-danger" role="alert">Could not update the rule. Please retry.</div><% } %>

<div class="card mb-3"><div class="card-body">
  <form method="GET" action="/rules" class="row g-2 align-items-end">
    <div class="col-md-5"><label class="form-label small" for="rule-search">Search rules</label><input class="form-control form-control-sm" id="rule-search" name="search" value="<%= filters.search %>" placeholder="Name, description, MITRE ID"></div>
    <div class="col-md-3"><label class="form-label small" for="rule-severity">Severity</label><select class="form-select form-select-sm" id="rule-severity" name="severity"><option value="">All severities</option><% ['CRITICAL','HIGH','MEDIUM','LOW'].forEach(s => { %><option value="<%= s %>" <%= filters.severity === s ? 'selected' : '' %>><%= s %></option><% }) %></select></div>
    <div class="col-md-2"><label class="form-label small" for="rule-status">Status</label><select class="form-select form-select-sm" id="rule-status" name="status"><option value="">All</option><option value="enabled" <%= filters.status === 'enabled' ? 'selected' : '' %>>Enabled</option><option value="disabled" <%= filters.status === 'disabled' ? 'selected' : '' %>>Disabled</option></select></div>
    <div class="col-md-2"><button class="btn btn-primary btn-sm w-100" type="submit"><i class="bi bi-search me-1"></i>Filter</button></div>
  </form>
</div></div>

<div class="card"><div class="table-responsive">
  <table class="table align-middle mb-0">
    <thead><tr><th>Rule</th><th>Description</th><th>Severity</th><th>Type</th><th>MITRE ATT&amp;CK</th><th>Status</th><th class="text-end">Action</th></tr></thead>
    <tbody>
      <% if (!rules.length) { %><tr><td colspan="7"><div class="empty-state">No detection rules match those filters.</div></td></tr><% } %>
      <% rules.forEach(rule => { %>
        <tr>
          <td><div class="fw-semibold small"><%= rule.title %></div><div class="small-mono"><%= rule.name %></div></td>
          <td class="small text-secondary rule-description"><%= rule.description %></td>
          <td><span class="badge <%= ({CRITICAL:'badge-critical',HIGH:'badge-high',MEDIUM:'badge-medium',LOW:'badge-low'})[rule.severity] || 'badge-info' %>"><%= rule.severity %></span></td>
          <td class="small text-secondary"><%= rule.rule_type %></td>
          <td class="small-mono"><%= rule.mitre_id || '—' %></td>
          <td><span class="badge <%= rule.enabled ? 'badge-status' : 'bg-secondary' %>"><%= rule.enabled ? 'ENABLED' : 'DISABLED' %></span></td>
          <td class="text-end"><% if (currentUser && currentUser.role === 'ADMIN') { %>
            <form method="POST" action="/rules/<%= rule.id %>/toggle" class="m-0">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button class="btn btn-sm <%= rule.enabled ? 'btn-outline-warning' : 'btn-outline-success' %>" type="submit"><%= rule.enabled ? 'Disable' : 'Enable' %></button>
            </form>
          <% } else { %><span class="small text-secondary">Admin only</span><% } %></td>
        </tr>
      <% }) %>
    </tbody>
  </table>
</div></div>
<div class="text-secondary small mt-3">Rule metadata and thresholds are loaded from <code>rules/*.json</code>. Enable state is stored in SQLite. Threshold editing is not available in this UI.</div>
