<!DOCTYPE html>
<html lang="en" data-bs-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
  <title><%= title %> · SOC Dashboard</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
  <link href="/css/style.css" rel="stylesheet">
</head>
<body>
  <div class="app-shell">
    <aside class="sidebar">
      <a class="brand" href="/" aria-label="SOC Dashboard home">
        <span class="brand-icon"><i class="bi bi-shield-lock-fill"></i></span>
        <span><strong>SOC</strong><small>OPERATIONS CONSOLE</small></span>
      </a>
      <div class="nav-caption">MONITOR</div>
      <nav class="sidebar-nav" aria-label="Main navigation">
        <a href="/" class="sidebar-link" data-sidebar-link><i class="bi bi-grid-1x2-fill"></i><span>Overview</span></a>
        <a href="/simulator" class="sidebar-link" data-sidebar-link><i class="bi bi-broadcast-pin"></i><span>Live Monitoring</span><span class="nav-live-dot"></span></a>
        <a href="/alerts" class="sidebar-link" data-sidebar-link><i class="bi bi-exclamation-diamond"></i><span>Alert queue</span></a>
        <a href="/incidents" class="sidebar-link" data-sidebar-link><i class="bi bi-folder2-open"></i><span>Incidents</span></a>
        <a href="/logs" class="sidebar-link" data-sidebar-link><i class="bi bi-list-ul"></i><span>Event logs</span></a>
        <a href="/ingest" class="sidebar-link" data-sidebar-link><i class="bi bi-cloud-arrow-up"></i><span>Import logs</span></a>
        <div class="nav-caption nav-caption-spaced">ANALYZE</div>
        <a href="/threat-intel" class="sidebar-link" data-sidebar-link><i class="bi bi-globe2"></i><span>Threat intelligence</span></a>
        <a href="/rules" class="sidebar-link" data-sidebar-link><i class="bi bi-diagram-3"></i><span>Detection rules</span></a>
        <a href="/assets" class="sidebar-link" data-sidebar-link><i class="bi bi-hdd-network"></i><span>Assets</span></a>
        <a href="/ai" class="sidebar-link" data-sidebar-link><i class="bi bi-stars"></i><span>AI analyst</span></a>
        <a href="/reports" class="sidebar-link" data-sidebar-link><i class="bi bi-file-earmark-bar-graph"></i><span>Reports</span></a>
        <div class="nav-caption nav-caption-spaced">ADMINISTRATION</div>
        <a href="/settings" class="sidebar-link" data-sidebar-link><i class="bi bi-sliders"></i><span>Settings</span></a>
        <% if (typeof currentUser !== 'undefined' && currentUser && currentUser.role === 'ADMIN') { %>
        <a href="/users" class="sidebar-link" data-sidebar-link><i class="bi bi-people"></i><span>Users &amp; access</span></a>
        <% } %>
      </nav>
      <div class="sidebar-bottom">
        <div class="sidebar-node"><span class="node-pulse"></span><div><strong>Single process</strong><small>SQLite event store</small></div></div>
        <% if (typeof currentUser !== 'undefined' && currentUser) { %>
        <div class="user-strip">
          <span class="user-avatar"><%= (currentUser.name || currentUser.username || 'U').slice(0,1).toUpperCase() %></span>
          <span class="user-meta"><strong><%= currentUser.name %></strong><small><%= currentUser.role %></small></span>
          <form action="/logout" method="POST" class="m-0">
            <button class="logout-button" title="Logout" aria-label="Logout"><i class="bi bi-box-arrow-right"></i></button>
          </form>
        </div>
        <% } %>
      </div>
    </aside>
    <main class="content">
      <header class="app-topbar">
        <div class="topbar-context"><span class="topbar-kicker">SECURITY OPERATIONS</span><span class="topbar-separator">/</span><span><%= title %></span></div>
        <div class="topbar-tools">
          <form class="top-search" action="/alerts" method="GET" role="search">
            <i class="bi bi-search" aria-hidden="true"></i>
            <label class="visually-hidden" for="global-alert-search">Search alerts</label>
            <input id="global-alert-search" type="search" name="search" placeholder="Search alerts" autocomplete="off">
            <kbd>/</kbd>
          </form>
          <div id="connection-status" class="connection-state is-connecting" role="status" aria-live="polite"><span class="connection-dot"></span><span class="connection-label">Connecting</span></div>
          <div class="topbar-clock" id="local-clock" aria-label="Local time"></div>
        </div>
      </header>
      <div class="page-content"><%- body %></div>
    </main>
  </div>

  <div id="liveToastContainer" class="toast-container position-fixed top-0 end-0 p-3"></div>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
  <script src="/socket.io/socket.io.js"></script>
  <script src="/js/csrf.js"></script>
  <script src="/js/ui.js"></script>
  <script src="/js/simulator.js"></script>
  <script src="/js/ingest.js"></script>
  <script src="/js/realtime.js"></script>
  <script src="/js/dashboard.js"></script>
  <script src="/js/ai.js"></script>
  <script src="/js/alerts.js"></script>
</body>
</html>
